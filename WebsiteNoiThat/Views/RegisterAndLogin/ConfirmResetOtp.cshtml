@{
    ViewBag.Title = "Xác nhận OTP & Đổi mật khẩu";
    Layout = null;
    string resetVerificationStatus = ViewBag.ResetVerificationStatus as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xác nhận OTP - Website Nội Thất</title>
    <link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap-glyphicons.css" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .card-box {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
            width: 100%;
            max-width: 820px;
            overflow: hidden;
            display: flex;
            flex-direction: row;
        }

        .left-banner {
            background: #f8faff;
            width: 42%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 25px;
            text-align: center;
            border-right: 1px solid #e3e6f0;
        }

        .icon-circle {
            width: 90px;
            height: 90px;
            background: #e8eefa;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            font-size: 42px;
        }

        .left-banner h3 {
            color: #333;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .left-banner p {
            color: #718096;
            font-size: 13.5px;
            line-height: 1.5;
        }

        .right-form {
            width: 58%;
            padding: 40px 35px;
        }

        .form-title {
            color: #2d3748;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 6px;
            text-align: center;
        }

        .form-desc {
            color: #718096;
            font-size: 13.5px;
            text-align: center;
            margin-bottom: 20px;
        }

        .input-group {
            margin-bottom: 15px;
        }

        .input-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #4a5568;
            margin-bottom: 5px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-control {
            width: 100%;
            height: 44px;
            padding: 10px 14px;
            font-size: 14.5px;
            border: 1px solid #cbd5e0;
            border-radius: 8px;
            outline: none;
            transition: all 0.2s;
            background-color: #fcfdfe;
        }

        .input-control:focus {
            border-color: #4e73df;
            box-shadow: 0 0 0 3px rgba(78, 115, 223, 0.2);
            background-color: #fff;
        }

        .btn-toggle-eye {
            position: absolute;
            right: 12px;
            background: none;
            border: none;
            color: #a0aec0;
            cursor: pointer;
            padding: 5px;
            font-size: 15px;
        }

        .btn-toggle-eye:hover {
            color: #4e73df;
        }

        .btn-submit {
            width: 100%;
            height: 46px;
            background: linear-gradient(180deg, #1cc88a 0%, #17a673 100%);
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(28, 200, 138, 0.35);
            transition: all 0.2s;
            margin-top: 10px;
        }

        .btn-submit:hover {
            background: linear-gradient(180deg, #17a673 0%, #13855c 100%);
        }

        .alert {
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13.5px;
            margin-bottom: 16px;
            text-align: center;
        }

        .alert-danger {
            background-color: #fff5f5;
            color: #c53030;
            border: 1px solid #feb2b2;
        }

        .alert-success {
            background-color: #f0fff4;
            color: #276749;
            border: 1px solid #9ae6b2;
        }

        .alert-info {
            background-color: #ebf8ff;
            color: #2b6cb0;
            border: 1px solid #90cdf4;
        }

        .alert-warning {
            background-color: #fffbeb;
            color: #975a16;
            border: 1px solid #f6e05e;
        }

        .links-group {
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #edf2f7;
            text-align: center;
        }

        .links-group a {
            color: #4e73df;
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 600;
        }

        .links-group a:hover {
            text-decoration: underline;
        }

        @@media (max-width: 768px) {
            .card-box {
                flex-direction: column;
            }
            .left-banner, .right-form {
                width: 100%;
                padding: 30px 20px;
            }
        }
    </style>
</head>

<body>

    <div class="card-box">
        <!-- Cột đồ họa -->
        <div class="left-banner">
            <div class="icon-circle">📩</div>
            @if (resetVerificationStatus == "Pending")
            {
                <h3>Đang xác minh giấy tờ</h3>
                <p>Yêu cầu khôi phục đang chờ ADMIN/MOD đối chiếu ảnh.</p>
            }
            else if (resetVerificationStatus == "Approved")
            {
                if (ViewBag.ResetOtpForCustomer != null)
                {
                    <h3>OTP khôi phục</h3>
                    <p>Giấy tờ đã khớp hồ sơ được duyệt. Lấy mã OTP hiển thị bên phải để tiếp tục.</p>
                }
                else
                {
                    <h3>Kiểm tra Email</h3>
                    <p>OTP đã được gửi đến email:<br /><b style="color: #4e73df; word-break: break-all;">@ViewBag.Email</b></p>
                }
                <p style="margin-top: 10px; font-size: 12px; color: #a0aec0;">Mã có hiệu lực trong 5 phút sau khi được gửi.</p>
                if (ViewBag.ResetOtpExpired != true && ViewBag.ResetOtpForCustomer == null)
                {
                    <p style="margin-top: 10px; font-size: 13px;">
                        <a href="/Chat" style="color: #4e73df; text-decoration: underline;">
                            <b>📩 Không nhận được email?</b> Xem mã OTP trong mục Tin nhắn
                        </a>
                        <br /><span style="font-size: 11px; color: #a0aec0;">(tra cứu bằng Email + Số điện thoại)</span>
                    </p>
                }
            }
            else
            {
                <h3>Trạng thái yêu cầu</h3>
                <p>Xem kết quả xác minh trên thông báo bên phải.</p>
            }
        </div>

        <!-- Cột form nhập -->
        <div class="right-form">
            <h2 class="form-title">Đặt lại mật khẩu</h2>
            <p class="form-desc">Tài khoản: @ViewBag.Email</p>

            @if (ViewBag.ResetOtpForCustomer != null)
            {
                <div class="alert alert-warning text-center">
                    Giấy tờ đã khớp với hồ sơ được ADMIN/MOD duyệt. Mã OTP của bạn có hiệu lực trong 5 phút:
                    <br /><strong style="font-size: 28px; letter-spacing: 6px;">@ViewBag.ResetOtpForCustomer</strong>
                </div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning">@TempData["Warning"]</div>
            }
            @if (resetVerificationStatus == "Pending")
            {
                <div class="alert alert-info">
                    Ảnh đang chờ ADMIN/MOD đối chiếu với ảnh gốc trong hồ sơ đăng ký. OTP chưa được gửi; vui lòng quay lại trang này sau khi có kết quả.
                    <br /><a href="@Url.Action("ForgotPassword", "RegisterAndLogin")">Quay lại trang quên mật khẩu</a>
                </div>
            }
            @if (resetVerificationStatus == "Rejected")
            {
                <div class="alert alert-danger">
                    Giấy tờ chưa được chấp nhận. Ghi chú: @(ViewBag.ResetVerificationNote ?? "Vui lòng gửi lại hồ sơ.")
                    <br /><a href="@Url.Action("ForgotPassword", "RegisterAndLogin")">Gửi lại giấy tờ xác minh</a>
                </div>
            }
            @if (resetVerificationStatus == "Completed")
            {
                <div class="alert alert-success">Yêu cầu đặt lại mật khẩu này đã hoàn tất.</div>
            }
            @if (resetVerificationStatus == "Approved" && ViewBag.ResetOtpExpired == true)
            {
                <div class="alert alert-danger">
                    Mã OTP chưa được gửi hoặc đã hết hạn. Hãy yêu cầu mã mới.
                    <br /><a href="@Url.Action("ForgotPassword", "RegisterAndLogin")">Yêu cầu OTP mới</a>
                </div>
            }
            @if (resetVerificationStatus == "Approved" && ViewBag.ResetOtpExpired != true)
            {
                <p class="form-desc">
                    @if (ViewBag.ResetOtpForCustomer != null)
                    {
                        @:Nhập mã OTP hiển thị phía trên và mật khẩu mới.
                    }
                    else
                    {
                        @:Nhập mã OTP trong email và mật khẩu mới.
                    }
                </p>
                <form method="post" action="@Url.Action("ConfirmResetOtp", "RegisterAndLogin")">
                    @Html.AntiForgeryToken()
                    <div class="alert-danger">
                        @Html.ValidationSummary(true, "")
                    </div>

                    <div class="input-group">
                        <label for="otpInput">Mã xác thực OTP (6 chữ số):</label>
                        <div class="input-wrapper">
                            <input type="text" id="otpInput" name="otpInput" class="input-control" placeholder="Ví dụ: 123456" maxlength="6" required autofocus style="letter-spacing: 4px; font-weight: bold;" />
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="newPassword">Mật khẩu mới (từ 8 đến 32 ký tự, gồm cả chữ và số):</label>
                        <div class="input-wrapper">
                            <input type="password" id="newPassword" name="newPassword" class="input-control" placeholder="Nhập mật khẩu mới" minlength="8" maxlength="32" data-pw-strength="true" required />
                            <button type="button" class="btn-toggle-eye" onclick="togglePass('newPassword', this)">
                                <span class="glyphicon glyphicon-eye-open"></span>
                            </button>
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="confirmPassword">Xác nhận lại mật khẩu mới:</label>
                        <div class="input-wrapper">
                            <input type="password" id="confirmPassword" name="confirmPassword" class="input-control" placeholder="Gõ lại mật khẩu mới" minlength="8" required />
                            <button type="button" class="btn-toggle-eye" onclick="togglePass('confirmPassword', this)">
                                <span class="glyphicon glyphicon-eye-open"></span>
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="btn-submit">Xác nhận đổi mật khẩu</button>
                </form>
            }

            <div class="links-group">
                <a href="@Url.Action("ForgotPassword", "RegisterAndLogin")">← Gửi lại mã OTP</a>
                <span style="color: #cbd5e0; margin: 0 8px;">|</span>
                <a href="@Url.Action("Login", "RegisterAndLogin")">Đăng nhập</a>
            </div>
        </div>
    </div>

    <script>
        function togglePass(inputId, btn) {
            var input = document.getElementById(inputId);
            var icon = btn.querySelector('.glyphicon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('glyphicon-eye-open');
                icon.classList.add('glyphicon-eye-close');
            } else {
                input.type = 'password';
                icon.classList.remove('glyphicon-eye-close');
                icon.classList.add('glyphicon-eye-open');
            }
        }
    </script>

    <!-- Kiểm tra độ mạnh mật khẩu (issue #130) -->
    <script src="~/Scripts/password-strength.js"></script>
</body>
</html>