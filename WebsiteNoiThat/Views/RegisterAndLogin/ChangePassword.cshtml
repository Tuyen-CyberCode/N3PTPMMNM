@model WebsiteNoiThat.Models.ChangePasswordModel

@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 25px; margin-bottom: 50px; max-width: 760px;">
    <h2 style="letter-spacing: 1px;"><i class="fa fa-lock" aria-hidden="true"></i> ĐỔI MẬT KHẨU</h2>
    <p style="color: #858796;">Đổi mật khẩu cho tài khoản của bạn. Chỉ mất vài giây với 3 bước nhỏ:</p>
    <hr />

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success">
            <strong>Thành công!</strong> @ViewBag.Success
        </div>
    }

    @using (Html.BeginForm("ChangePassword", "RegisterAndLogin", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div style="margin-top: 20px;">
            <!-- BƯỚC 1 -->
            <div style="display:flex; margin-bottom: 22px;">
                <div style="flex:0 0 46px;">
                    <span style="display:inline-block; width:34px; height:34px; border-radius:50%; background:#4e73df; color:#fff; text-align:center; line-height:34px; font-weight:bold;">1</span>
                </div>
                <div style="flex:1">
                    <h5 style="margin-top:6px;"><b>Nhập mật khẩu cũ</b></h5>
                    <div style="max-width: 480px;">
                        @Html.PasswordFor(model => model.OldPassword, new { @class = "form-control", placeholder = "Mật khẩu bạn đang dùng hiện tại" })
                        @Html.ValidationMessageFor(model => model.OldPassword, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <!-- BƯỚC 2 -->
            <div style="display:flex; margin-bottom: 22px;">
                <div style="flex:0 0 46px;">
                    <span style="display:inline-block; width:34px; height:34px; border-radius:50%; background:#1cc88a; color:#fff; text-align:center; line-height:34px; font-weight:bold;">2</span>
                </div>
                <div style="flex:1">
                    <h5 style="margin-top:6px;"><b>Nhập mật khẩu mới</b></h5>
                    <div style="max-width: 480px;">
                        @Html.PasswordFor(model => model.NewPassword, new { @class = "form-control", placeholder = "Từ 6 đến 32 ký tự", maxlength = "32" })
                        @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
                        <small style="color:#858796;">Nên dùng tổ hợp chữ, số và ký tự đặc biệt. Mật khẩu mới phải khác mật khẩu cũ.</small>
                    </div>
                </div>
            </div>

            <!-- BƯỚC 3 -->
            <div style="display:flex; margin-bottom: 22px;">
                <div style="flex:0 0 46px;">
                    <span style="display:inline-block; width:34px; height:34px; border-radius:50%; background:#f6c23e; color:#fff; text-align:center; line-height:34px; font-weight:bold;">3</span>
                </div>
                <div style="flex:1">
                    <h5 style="margin-top:6px;"><b>Xác nhận mật khẩu mới</b></h5>
                    <div style="max-width: 480px;">
                        @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control", placeholder = "Gõ lại mật khẩu mới lần nữa" })
                        @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <div style="margin: 25px 0 10px 46px;">
            <button type="submit" class="btn btn-primary" style="min-width: 180px;"><i class="fa fa-check"></i> Xác nhận đổi mật khẩu</button>
            <a href="@Url.Action("ViewCurentUser", "RegisterAndLogin")" class="btn btn-secondary" style="margin-left:10px;">Quay lại thông tin tài khoản</a>
        </div>
    }

    <div style="margin: 20px 0 0 46px; padding-top: 14px; border-top: 1px solid #eee;">
        <i class="fa fa-life-ring" aria-hidden="true" style="color:#e74a3b;"></i>
        <b>Bước cứu hộ:</b>
        nếu quên mật khẩu, <a href="@Url.Action("ForgotPassword", "RegisterAndLogin")">lấy lại mật khẩu qua email</a> (mã xác thực OTP sẽ được gửi tới địa chỉ email đã đăng ký).
    </div>
</div>

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script>
    window.addEventListener('load', function () {
        if (window.jQuery && window.jQuery.validator) {
            window.jQuery.extend(window.jQuery.validator.messages, {
                required: "Vui lòng điền thông tin này.",
                minlength: "Tối thiểu {0} ký tự.",
                maxlength: "Tối đa {0} ký tự.",
                equalTo: "Giá trị không khớp."
            });
        }
    });
</script>
