@model List<Models.DAO.TrackOrderView>
@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top:20px; margin-bottom:40px">
    <h2><i class="fa fa-file-text-o" style="color:#e4393c"></i> Đơn hàng của tôi</h2>
    <hr />

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Bạn chưa có đơn hàng nào. <a href="/">Tiếp tục mua sắm <i class="fa fa-arrow-right"></i></a>
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr style="background-color:#f5f5f5">
                    <th>Mã đơn</th>
                    <th>Người nhận</th>
                    <th>Ngày cập nhật</th>
                    <th>Trạng thái</th>
                    <th style="text-align:right">Tổng tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    var cls = o.Order.StatusId == 5 ? "label-success" : (o.Order.StatusId == 4 ? "label-warning" : "label-info");
                    <tr>
                        <td style="vertical-align:middle"><strong>#@o.Order.OrderId</strong></td>
                        <td>@o.Order.ShipName</td>
                        <td>@(o.Order.UpdateDate != null ? o.Order.UpdateDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                        <td>
                            <span class="label @cls">@o.StatusName</span>
                        </td>
                        <td style="text-align:right; vertical-align:middle; color:#e4393c; font-weight:bold">@string.Format("{0:N0}", o.Total)₫</td>
                        <td style="vertical-align:middle">
                            <a href="/theo-doi-don-hang?id=@o.Order.OrderId" class="btn btn-outline-primary btn-sm">
                                <i class="fa fa-map-marker"></i> Theo dõi
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
