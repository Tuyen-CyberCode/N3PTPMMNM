
@model WebsiteNoiThat.Models.EmailModel
@{
    ViewBag.Title = "Liên hệ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap-glyphicons.css" rel="stylesheet">

<style>
    .contact-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 15px;
    }

    .contact-info {
        margin: 20px 0;
        padding: 22px;
        background: #fff;
        border-left: 4px solid #d9534f;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.07);
        border-radius: 6px;
    }

        .contact-info h3 {
            margin-top: 0;
            color: #333;
            font-size: 25px;
            font-weight: 600;
        }

        .contact-info h4 {
            color: #666;
            font-size: 16px;
            line-height: 1.8;
        }

    .contact-title {
        margin-top: 30px;
        margin-bottom: 20px;
        font-weight: 600;
        color: #333;
    }

    .contact-form {
        background: #fff;
        padding: 20px;
        border: 1px solid #eee;
        border-radius: 8px;
        margin-bottom: 30px;
    }

        .contact-form .form-group {
            margin-bottom: 20px;
        }

        .contact-form textarea.form-control {
            min-height: 110px;
            resize: vertical;
        }

    .map-contact {
        width: 100%;
        margin: 35px auto;
    }

    .map-contact-header {
        text-align: center;
        margin-bottom: 18px;
    }

        .map-contact-header h3 {
            color: #333;
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 8px;
        }

            .map-contact-header h3 .glyphicon {
                color: #d9534f;
                margin-right: 6px;
            }

        .map-contact-header p {
            color: #777;
            font-size: 15px;
            margin: 0;
        }

    .map-contact-frame {
        width: 100%;
        height: 380px;
        overflow: hidden;
        border-radius: 12px;
        border: 1px solid #eee;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);
        background: #f5f5f5;
    }

        .map-contact-frame iframe {
            display: block;
            width: 100%;
            height: 100%;
            border: 0;
        }

    .contact-submit {
        min-width: 110px;
        padding: 10px 25px;
        border-radius: 5px;
    }

    @@media (max-width: 767px) {
        .contact-page {
            padding: 10px;
        }

        .contact-info {
            padding: 16px;
        }

            .contact-info h3 {
                font-size: 21px;
            }

        .contact-form {
            padding: 12px;
        }

        .map-contact-header h3 {
            font-size: 20px;
        }

        .map-contact-frame {
            height: 280px;
            border-radius: 8px;
        }
    }
</style>

<div class="contact-page">

    <div class="breadcrumb-wp">
        <ol class="breadcrumb">
            <li>
                <a class="pink" href="/">
                    <i class="glyphicon glyphicon-home"></i>
                </a>
            </li>
            <li class="active">Liên Hệ</li>
        </ol>
    </div>

    <div class="contact-info">
        <h3>
            <i class="glyphicon glyphicon-map-marker"></i>
            Studio Nội thất Cao Cấp An Huy
        </h3>

        <h4>
            <i class="glyphicon glyphicon-home"></i>
            Địa chỉ: Ngõ 34 - Phú Kiều - Kiều Mai
        </h4>

        <h4>
            <i class="glyphicon glyphicon-phone-alt"></i>
            Tel: 01649.629.629
        </h4>
    </div>

    <h3 class="contact-title"><i class="glyphicon glyphicon-envelope"></i> GỬI YÊU CẦU HỖ TRỢ KHÁCH HÀNG</h3>

    @if (ViewBag.Status != null)
    {
        <div class="alert alert-success" style="font-size: 15px; margin-bottom: 20px;">
            <i class="glyphicon glyphicon-ok-sign"></i> @ViewBag.Status
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" style="font-size: 15px; margin-bottom: 20px;">
            <i class="glyphicon glyphicon-exclamation-sign"></i> @ViewBag.Error
        </div>
    }

    @using (Html.BeginForm("Contacts", "Contact", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal contact-form">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                <label class="control-label col-md-2" for="EmailCC">Email của bạn: <span class="text-danger">*</span></label>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.EmailCC,
                        new { @class = "form-control", @placeholder = "Nhập email của bạn để chúng tôi phản hồi...", @type = "email", @required = "required" })
                    @Html.ValidationMessageFor(model => model.EmailCC, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2" for="EmailSubject">Tiêu đề hỗ trợ:</label>
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.EmailSubject,
                        new { @class = "form-control", @placeholder = "Ví dụ: Tư vấn mua hàng, hỏi tiến độ đơn hàng, bảo hành..." })
                    @Html.ValidationMessageFor(model => model.EmailSubject, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-md-2" for="EMailBody">Nội dung hỗ trợ: <span class="text-danger">*</span></label>
                <div class="col-md-10">
                    @Html.TextAreaFor(model => model.EMailBody,
                        new { @class = "form-control", @rows = "5", @placeholder = "Mô tả chi tiết câu hỏi hoặc yêu cầu cần hỗ trợ của bạn...", @required = "required" })
                    @Html.ValidationMessageFor(model => model.EMailBody, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <button type="submit" class="btn btn-primary contact-submit" style="font-size: 15px; font-weight: bold;">
                        <i class="glyphicon glyphicon-send"></i> Gửi yêu cầu hỗ trợ
                    </button>
                </div>
            </div>

        </div>
    }

    <div class="map-contact">
        <div class="map-contact-header">
            <h3>
                <i class="glyphicon glyphicon-map-marker"></i>
                VỊ TRÍ CỬA HÀNG
            </h3>
            <p>Studio Nội thất Cao Cấp An Huy</p>
        </div>

        <div class="map-contact-frame">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1514.2625289894554!2d109.29136398293879!3d13.12304776243618!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x316fec8410ea0c51%3A0x1f139522d7911691!2zVHLGsOG7nW5nIMSQ4bqhaSBo4buNYyBYw6J5IGThu7FuZyBNaeG7gW4gVHJ1bmc!5e1!3m2!1svi!2s!4v1792144216868!5m2!1svi!2s"
                    allowfullscreen
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin">
            </iframe>
        </div>
    </div>

</div>

<div class="boxmain">
    @Html.Action("NewProduct", "Product")
    @Html.Action("CateKorea", "Product")
    @Html.Action("CateHavana", "Product")
</div>
