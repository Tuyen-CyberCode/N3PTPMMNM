@model Models.EF.Product

<style>
    .zoom { transition: transform .2s; }
    .zoom:hover { transform: scale(1.04); }
    #maincontent {
        min-width: 0;
        overflow-x: hidden;
        background: transparent !important;
    }
    .product-detail {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        margin-bottom: 20px;
        padding: 20px;
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
    }
    .product-detail__title {
        margin: 0 0 22px;
        color: #333;
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        overflow-wrap: anywhere;
    }
    .product-detail__main {
        display: grid;
        grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
        gap: 28px;
        align-items: start;
    }
    .product-detail__image {
        display: flex;
        min-width: 0;
        min-height: 300px;
        align-items: center;
        justify-content: center;
        padding: 12px;
        border: 1px solid #eee;
        border-radius: 4px;
    }
    .product-detail__image img {
        display: block;
        width: 100%;
        max-height: 420px;
        object-fit: contain;
    }
    .product-detail__info {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 16px;
    }
    .product-detail__info p {
        margin: 0;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }
    .product-detail__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .product-detail__actions .btn {
        white-space: normal;
    }
    .product-tabs {
        max-width: 100%;
        margin-right: 0;
        margin-left: 0;
    }
    .product-tabs .nav-tabs {
        display: flex;
        flex-wrap: wrap;
    }
    .product-tabs .nav-tabs > li {
        float: none;
    }
    .product-tabs .tab-content {
        overflow-wrap: anywhere;
    }
    .product-related {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        clear: both;
        margin-top: 35px;
        padding: 20px;
        border: 1px solid #e5e5e5;
        border-radius: 6px;
        background: #f5f5f5;
    }
    .product-related .owl-item {
        padding: 5px;
    }
    .product-related .imgsp img {
        width: 150px;
        height: 200px;
        object-fit: contain;
    }
    .product-related .button-hd .is-unavailable {
        display: inline-block;
        width: 80%;
        height: 30px;
        border-radius: 3px;
        background: #999;
        color: #fff;
        line-height: 30px;
        text-align: center;
        cursor: not-allowed;
    }
    .boxmain {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        clear: both;
        overflow: hidden;
        background: transparent;
    }
    .boxmain > .row {
        margin-right: 0;
        margin-left: 0;
    }
    @@media (max-width: 767px) {
        .product-detail {
            padding: 14px;
        }
        .product-detail__main {
            grid-template-columns: minmax(0, 1fr);
            gap: 18px;
        }
        .product-detail__image {
            min-height: 220px;
        }
        .product-detail__image img {
            max-height: 340px;
        }
        .product-detail__title {
            font-size: 20px;
        }
        .product-related {
            padding: 14px;
        }
    }
</style>

@section Noidungbenphai{
    <section class="product-detail">
        <h1 class="product-detail__title">@Model.Name.ToUpper()</h1>
        <div class="product-detail__main">
            <div class="product-detail__image">
                <img id="zoom_04" class="zoom" src="@Url.Content("~/image/" + Model.Photo)" alt="@Model.Name" />
            </div>
            <div class="product-detail__info">
                <p><strong>Mã sản phẩm:</strong> @Model.ProductId</p>
                <p class="status">Tên sản phẩm: <span class="pink" style="font-weight:600;">@Model.Name</span></p>
                @if (Model.Quantity > 0)
                {
                    <p class="status">Tình trạng: <span class="pink" style="color:#28a745;font-weight:600;">còn @Model.Quantity sản phẩm</span></p>
                }
                else
                {
                    <p class="status">Tình trạng: <span class="pink" style="color:#d9534f;font-weight:600;">Hết hàng</span></p>
                }
                <div>
                    <p class="status">Giá gốc: <span class="pink" style="text-decoration:line-through;color:#999;">@string.Format("{0:#,###.##}", Model.Price)₫</span></p>
                    @if (Model.Discount > 0)
                    {
                        <p class="status">Giá KM (@Model.Discount%): <span class="pink" style="color:#e0393e;font-weight:bold;font-size:16px;">@string.Format("{0:#,###.##}", (Model.Price - (Model.Price * Model.Discount * 0.01)))₫</span></p>
                    }
                </div>
                <p class="status">
                    Đánh giá:
                    @if (ViewBag.AvgRate != null)
                    {
                        var avg = (double)ViewBag.AvgRate;
                        var saoDay = (int)Math.Round(avg);
                        for (var i = 1; i <= 5; i++)
                        {
                            <i class="fa @(i <= saoDay ? "fa-star" : "fa-star-o")" style="color:#f5a623"></i>
                        }
                        <span>@avg.ToString("0.0")/5 · @ViewBag.FeedbackCount đánh giá</span>
                    }
                    else
                    {
                        <span style="color:#999">Chưa có đánh giá</span>
                    }
                </p>
                <div class="product-detail__actions">
                    <a href="/them-gio-hang?productid=@Model.ProductId&quantity=1" class="btn btn-primary"><i class="fa fa-cart-plus" aria-hidden="true"></i> Đặt mua hàng</a>
                    @if (ViewBag.IsFavorite != null && (bool)ViewBag.IsFavorite)
                    {
                        <a href="/Wishlist/Toggle/@Model.ProductId" class="btn btn-default" style="color:#e0393e"><i class="fa fa-heart" aria-hidden="true"></i> Đã yêu thích (bỏ)</a>
                    }
                    else
                    {
                        <a href="/Wishlist/Toggle/@Model.ProductId" class="btn btn-default"><i class="fa fa-heart-o" aria-hidden="true"></i> Yêu thích</a>
                    }
                </div>
            </div>
        </div>
    </section>
}

<hr>

<div class="row product-tabs">
    <div class="short-des col-sm-12 col-xs-12">
        <ul class="nav nav-tabs" style="font-size:17px">
            <li class="nav active"><a href="#produc-des" data-toggle="tab"> Mô tả sản phẩm</a></li>
            <li class="nav"><a href="#tab-gh" data-toggle="tab"> Giao hàng </a></li>
            <li class="nav"><a href="#tab-th" data-toggle="tab"> Trả hàng </a></li>
            <li class="nav"><a href="#tab-bh" data-toggle="tab"> Bảo hành </a></li>
            <li class="nav"><a href="#tab-dg" data-toggle="tab"> Đánh giá <span style="font-size:13px; color:#999">(@ViewBag.FeedbackCount)</span></a></li>
        </ul>

        <!-- Tab panes -->
        <div class="tab-content" style="margin-top:15px; margin-bottom:10px">
            <div class="tab-pane fade in active" id="produc-des">
                <h2>@Model.Name</h2>
                <p style="font-size:16px; line-height:1.9; text-align:justify; color:#555; white-space:pre-line">@Model.Description</p>
            </div>

            <div class="tab-pane fade" id="tab-gh">
                <div align="justify">
                    <p><strong>I. Vận chuyển/ shipping</strong></p>
                    <p><strong>A. Gói tiết kiệm:</strong><br>- Địa điểm: nơi xe tải 2 tấn (hẻm rộng &gt; 5m) có thể vào được.</p>
                    <p>- Đưa hàng nặng, cồng kềnh lên lầu cao (hoặc chung cư bằng thang bộ): Quý Khách xin vui lòng sử dụng gói giao theo yêu cầu ở dưới đây<br>- Thời gian giao hàng: trong vòng 5 ngày đối với nội thành (12 ngày đối với ngoại tỉnh) kể từ ngày xác nhận đơn hàng.</p>
                    <p><strong>B. Gói dịch vụ:</strong><br>- Địa điểm giao hàng: đường cấm xe tải, vào hẻm nhỏ, hoặc khiêng vác lên tầng lầu cao cần ít nhất 2 người.</p>
                    <p>- Thời gian giao hàng: giao ngay trong ngày theo giờ yêu cầu nếu hàng có sẵn tại kho trung chuyển.</p>
                    <p><strong>2. Lắp ráp/ installation</strong></p>
                    <p>- Giá vận chuyển trên đây đã gồm kèm dịch vụ lắp ráp miễn phí đối với các thành phố có kho trung chuyển.</p>
                    <p>- Quý khách cần các dịch vụ khác như khoan bắt lên tường, tháo bỏ đồ cũ, cắt thêm kính... vui lòng liên hệ trước.</p>
                </div>
            </div>

            <div class="tab-pane fade" id="tab-th">
                <p align="justify"><strong>Đổi trả khi hàng hóa không đúng chất lượng công bố</strong></p>
                <p align="justify">Để đảm bảo quyền lợi của khách hàng và trách nhiệm của bên vận chuyển, khách hàng cần kiểm tra hàng hóa kỹ khi nhận hàng.</p>
                <p align="justify"><strong>Đổi trả khi không phù hợp với căn nhà</strong></p>
                <p align="justify">+ Chi phí vận chuyển: Trong trường hợp đổi ý sau khi xe giao hàng đã đi thì Quý khách trả chi phí vận chuyển 2 chiều.</p>
                <p align="justify">+ Quý khách sẽ không được trả lại tiền hàng sau khi đã hoàn tất thanh toán.</p>
            </div>

            <div class="tab-pane fade" id="tab-bh">
                <p><strong>Thời hạn bảo hành theo quy định của nhà máy</strong></p>
                <p>Mọi sản phẩm của chúng tôi được bảo hành trong vòng 6 tháng kể từ ngày ghi trên phiếu giao hàng.</p>
                <p><strong>Các lỗi được bảo hành trong 6 tháng:</strong> Gãy vỡ do thiết kế, sơn bong tróc, mối mọt ăn từ trong gỗ ra.</p>
            </div>

            <div class="tab-pane fade" id="tab-dg">
                <div id="fb-summary" style="margin-bottom:15px">
                    <strong>Đánh giá của khách hàng:</strong>
                    @if (ViewBag.AvgRate != null)
                    {
                        var avg = (double)ViewBag.AvgRate;
                        var saoDay = (int)Math.Round(avg);
                        for (var i = 1; i <= 5; i++)
                        {
                            <i class="fa @(i <= saoDay ? "fa-star" : "fa-star-o")" style="color:#f5a623; font-size:18px"></i>
                        }
                        <span>@avg.ToString("0.0")/5 · @ViewBag.FeedbackCount đánh giá</span>
                    }
                    else
                    {
                        <span style="color:#999">Chưa có đánh giá nào — bạn hãy là người đầu tiên!</span>
                    }
                </div>

                <div id="fb-list" style="margin-bottom:20px">
                    @foreach (var f in (List<Models.DAO.FeedbackView>)ViewBag.Feedbacks)
                    {
                        <div class="fb-item" style="border-bottom:1px solid #eee; padding:10px 0">
                            <div>
                                <strong>@f.DisplayName</strong>
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="fa @(i <= f.Rate ? "fa-star" : "fa-star-o")" style="color:#f5a623"></i>
                                }
                                <span style="color:#999; font-size:12px; margin-left:8px">@f.Time.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <p style="margin:6px 0 0; line-height:1.7">@f.Content</p>
                        </div>
                    }
                </div>

                <div id="fb-form">
                    @if (Session[WebsiteNoiThat.Common.Commoncontent.user_sesion] != null)
                    {
                        <strong>Viết đánh giá của bạn:</strong>
                        <div id="fb-stars" style="margin:8px 0">
                            <span style="margin-right:6px">Chọn số sao:</span>
                            @{ for (var i = 1; i <= 5; i++)
                                {
                                    <i class="fa fa-star-o fb-star" data-rate="@i" style="color:#f5a623; font-size:22px; cursor:pointer; margin-right:4px"></i>
                                } }
                            <span id="fb-rate-text" style="color:#999; margin-left:6px"></span>
                            <input type="hidden" id="fb-rate" value="0" />
                        </div>
                        <textarea id="fb-content" rows="3" maxlength="500" class="form-control" style="max-width:600px" placeholder="Chia sẻ cảm nhận về sản phẩm..."></textarea>
                        <div style="margin-top:10px">
                            <button type="button" id="fb-send" class="btn btn-primary"><i class="fa fa-paper-plane"></i> Gửi đánh giá</button>
                            <span id="fb-note" style="margin-left:10px"></span>
                        </div>
                    }
                    else
                    {
                        <p><a href="/dang-nhap">Đăng nhập</a> để gửi đánh giá về sản phẩm này. Cảm ơn bạn!</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var relatedProducts = (ViewBag.RelatedProducts as List<Models.EF.Product>) ?? new List<Models.EF.Product>();
}
@if (relatedProducts.Count > 0)
{
    <section class="product-related">
        <h3 id="title_spmoi" style="text-align:center;">SẢN PHẨM LIÊN QUAN</h3>
        <div id="related-products-carousel" class="owl-carousel owl-theme">
            @foreach (var sp in relatedProducts)
            {
                <div class="item">
                    <div class="boxsp">
                        <div class="imgsp">
                            <a href="@Url.Action("DetailProduct", new { @Id = sp.ProductId })" title="@sp.Name">
                                <img class="imgproduct" src="@Url.Content("~/image/" + sp.Photo)" alt="@sp.Name" />
                            </a>
                        </div>
                        <div class="namesp">
                            <a href="@Url.Action("DetailProduct", new { @Id = sp.ProductId })">@sp.Name</a>
                        </div>
                        @if (sp.Discount > 0)
                        {
                            <div class="pricesp" style="color:crimson;">@string.Format("{0:#,###.##}", (sp.Price - (sp.Price * sp.Discount * 0.01)))₫</div>
                            <div style="margin-top:-10px; color:#999; font-size:12px; text-decoration:line-through;">@sp.Price.GetValueOrDefault(0).ToString("N0")₫</div>
                        }
                        else
                        {
                            <div class="pricesp">@sp.Price.GetValueOrDefault(0).ToString("N0")₫</div>
                        }
                        <div class="button-hd">
                            @if ((sp.Quantity ?? 0) > 0)
                            {
                                <a href="/them-gio-hang?productid=@sp.ProductId&quantity=1" title="Thêm vào giỏ hàng" aria-label="Thêm @sp.Name vào giỏ hàng">
                                    <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                                </a>
                            }
                            else
                            {
                                <span class="is-unavailable" title="Sản phẩm đã hết hàng" aria-label="Sản phẩm đã hết hàng">
                                    <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<hr />
<div class="boxmain">
    @Html.Action("NewProduct", "Product")
    @Html.Action("CateKorea", "Product")
    @Html.Action("CateHavana", "Product")
</div>

<script type="text/javascript">
    window.addEventListener('load', function () {
        var stars = document.querySelectorAll('.fb-star');
        var rateInput = document.getElementById('fb-rate');
        var note = document.getElementById('fb-note');
        if (!stars.length || !rateInput) {
            if (window.location.hash === '#tab-dg') {
                var link0 = document.querySelector('a[href="#tab-dg"]');
                try { if (link0) { window.jQuery(link0).tab('show'); } } catch (e) { }
            }
            return;
        }

        function paint(rate) {
            for (var i = 0; i < stars.length; i++) {
                var r = parseInt(stars[i].getAttribute('data-rate'), 10);
                stars[i].className = 'fa ' + (r <= rate ? 'fa-star' : 'fa-star-o') + ' fb-star';
                stars[i].style.color = '#f5a623';
                stars[i].style.fontSize = '22px';
                stars[i].style.cursor = 'pointer';
                stars[i].style.marginRight = '4px';
            }
            rateInput.value = rate;
            var label = document.getElementById('fb-rate-text');
            if (label) label.textContent = rate > 0 ? rate + '/5 sao' : '';
        }

        for (var i = 0; i < stars.length; i++) {
            stars[i].addEventListener('click', function () {
                paint(parseInt(this.getAttribute('data-rate'), 10) || 0);
            });
        }

        if (window.location.hash === '#tab-dg') {
            var link = document.querySelector('a[href="#tab-dg"]');
            try { if (link) { window.jQuery(link).tab('show'); } } catch (e) { }
            var target = document.getElementById('tab-dg');
            if (target) target.scrollIntoView({ block: 'start' });
        }

        var btn = document.getElementById('fb-send');
        if (btn) {
            btn.addEventListener('click', function () {
                var rate = parseInt(rateInput.value, 10) || 0;
                var content = document.getElementById('fb-content').value.trim();
                if (rate < 1 || !content) {
                    note.textContent = 'Bạn cần chọn số sao và viết nội dung đánh giá.';
                    note.style.color = '#d9534f';
                    return;
                }
                if (note) { note.textContent = 'Đang gửi...'; note.style.color = '#999'; }
                window.jQuery.post('/Product/AddFeedback', {
                    productId: '@Model.ProductId',
                    rate: rate,
                    content: content
                })
                .done(function (res) {
                    if (res && res.success) {
                        window.location.href = window.location.pathname + '#tab-dg';
                        window.location.reload();
                    } else if (res && res.error === 'login') {
                        note.textContent = 'Bạn cần đăng nhập để đánh giá.';
                        note.style.color = '#d9534f';
                    } else if (res && res.error === 'data') {
                        note.textContent = 'Dữ liệu chưa hợp lệ (sao 1-5, nội dung tối đa 500 ký tự).';
                        note.style.color = '#d9534f';
                    } else {
                        note.textContent = 'Không gửi được đánh giá, vui lòng thử lại sau.';
                        note.style.color = '#d9534f';
                    }
                })
                .fail(function () {
                    note.textContent = 'Lỗi kết nối, vui lòng thử lại sau.';
                    note.style.color = '#d9534f';
                });
            });
        }
    });
</script>
@section jsFooter{
    <script type="text/javascript">
        $(function () {
            $("#related-products-carousel").owlCarousel({
                itemsCustom: [
                    [0, 1],
                    [480, 2],
                    [768, 3],
                    [1200, 4]
                ],
                pagination: true,
                navigation: false,
                autoPlay: 3000,
                slideSpeed: 300,
                paginationSpeed: 400
            });
        });
    </script>
}