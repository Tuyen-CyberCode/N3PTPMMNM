@{
    ViewBag.Title = "Quên mật khẩu quản trị";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu quản trị - Website Nội Thất</title>
    <link href="~/Content/admin/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/Content/admin/css/sb-admin-2.min.css" rel="stylesheet">
</head>

<body class="bg-gradient-primary">
    <div class="container">
        <div class="row justify-content-center" style="min-height: 100vh; align-items: center;">
            <div class="col-xl-10 col-lg-12 col-md-9">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="row">
                            <div class="col-lg-6 d-none d-lg-block bg-login-image"></div>
                            <div class="col-lg-6">
                                <div class="p-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-2">Quên mật khẩu quản trị?</h1>
                                        <p class="mb-4">Nhập email quản trị, hệ thống sẽ gửi mã OTP để đặt lại mật khẩu.</p>
                                    </div>

                                    @if (!ViewData.ModelState.IsValid)
                                    {
                                        <div class="alert alert-danger small text-center">
                                            @Html.ValidationSummary(true, "")
                                        </div>
                                    }

                                    @using (Html.BeginForm("ForgotPassword", "Login", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <div class="form-group">
                                            <input type="email" name="Email" id="Email" class="form-control form-control-user"
                                                   placeholder="Email quản trị (VD: admin@nha.vn)" required autofocus />
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-user btn-block">
                                            Gửi mã OTP
                                        </button>
                                    }

                                    <hr>
                                    <div class="text-center">
                                        <a class="small" href="@Url.Action("Index", "Login")">← Về trang đăng nhập</a>
                                    </div>
                                    <div class="text-center mt-2">
                                        <a class="small" href="@Url.Action("ForgotPassword", "RegisterAndLogin", new { area = "" })">Bạn là khách hàng?</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Content/admin/vendor/jquery/jquery.min.js"></script>
    <script src="~/Content/admin/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/admin/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/Content/admin/js/sb-admin-2.min.js"></script>
</body>
</html>
