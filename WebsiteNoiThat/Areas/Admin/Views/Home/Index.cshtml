
@{
    ViewBag.Title = "Giới thiệu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Giới thiệu hệ thống</h1>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">TRANG QUẢN TRỊ NOITHATGO.VN</h6>
    </div>
    <div class="card-body">
        <p class="mb-3">
            Hệ thống quản trị NOITHATGO.VN hỗ trợ nhân viên quản lý toàn bộ hoạt động kinh doanh,
            từ danh mục nội thất và nhà cung cấp đến khách hàng, đơn hàng, tài khoản và phân quyền.
        </p>

        <h6 class="font-weight-bold mt-4">Chức năng chính</h6>
        <div class="row">
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="border-left-primary shadow-sm p-3 h-100">
                    <i class="fas fa-box-open text-primary mr-2"></i>
                    <b>Quản lý sản phẩm</b>
                    <p class="small text-muted mb-0 mt-2">Thêm, sửa, xóa và cập nhật danh mục nội thất.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="border-left-success shadow-sm p-3 h-100">
                    <i class="fas fa-shopping-cart text-success mr-2"></i>
                    <b>Quản lý đơn hàng</b>
                    <p class="small text-muted mb-0 mt-2">Theo dõi đơn đặt hàng và tình trạng xử lý.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 mb-3">
                <div class="border-left-info shadow-sm p-3 h-100">
                    <i class="fas fa-users text-info mr-2"></i>
                    <b>Quản lý người dùng</b>
                    <p class="small text-muted mb-0 mt-2">Quản lý khách hàng, nhân viên và phân quyền truy cập.</p>
                </div>
            </div>
        </div>

        <h6 class="font-weight-bold mt-3">Hướng dẫn sử dụng</h6>
        <p class="mb-1">Sử dụng thanh điều hướng bên trái để truy cập từng chức năng quản trị.</p>
        <p class="mb-0">Nhập thông tin chính xác, kiểm tra kỹ trước khi lưu hoặc cập nhật dữ liệu.</p>
    </div>
</div>
