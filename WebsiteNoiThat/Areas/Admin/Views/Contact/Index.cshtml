@model IEnumerable<Models.EF.Contact>

@{
    ViewBag.Title = "Quản lý hỗ trợ khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-headset text-primary mr-2"></i>Quản lý Hỗ Trợ Khách Hàng
        </h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i>@TempData["Warning"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách yêu cầu hỗ trợ từ khách hàng</h6>
            <div>
                <span class="badge badge-warning p-2 mr-2"><i class="fas fa-clock mr-1"></i>Chưa xử lý: @Model.Count(c => c.Status != true)</span>
                <span class="badge badge-success p-2"><i class="fas fa-check-circle mr-1"></i>Đã xử lý: @Model.Count(c => c.Status == true)</span>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTableSupport" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 70px;">Mã</th>
                            <th style="width: 220px;">Email khách hàng</th>
                            <th>Nội dung yêu cầu</th>
                            <th style="width: 140px;" class="text-center">Trạng thái</th>
                            <th style="width: 170px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="font-weight-bold text-center">#@item.ContactId</td>
                                <td>
                                    <i class="fas fa-envelope text-muted mr-1"></i>
                                    <strong>@(string.IsNullOrEmpty(item.EmailCC) ? "Không có email" : item.EmailCC)</strong>
                                </td>
                                <td>
                                    <div style="white-space: pre-line; max-height: 120px; overflow-y: auto;">@item.Content</div>
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.Status == true)
                                    {
                                        <span class="badge badge-success px-2 py-1">
                                            <i class="fas fa-check-circle mr-1"></i>Đã xử lý
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning px-2 py-1 text-dark">
                                            <i class="fas fa-clock mr-1"></i>Chờ hỗ trợ
                                        </span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <button type="button" 
                                            class="btn btn-sm btn-primary btn-reply mb-1" 
                                            data-id="@item.ContactId" 
                                            data-email="@item.EmailCC" 
                                            data-content="@item.Content"
                                            title="Phản hồi và gửi email cho khách hàng">
                                        <i class="fas fa-reply mr-1"></i>Hỗ trợ
                                    </button>

                                    @using (Html.BeginForm("Delete", "Contact", FormMethod.Post, new { style = "display:inline-block;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.ContactId" />
                                        <button type="submit" 
                                                class="btn btn-sm btn-outline-danger mb-1" 
                                                onclick="return confirm('Bạn có chắc chắn muốn xóa yêu cầu hỗ trợ #@item.ContactId này không?');"
                                                title="Xóa yêu cầu">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Phản hồi & Gửi Email -->
<div class="modal fade" id="replyModal" tabindex="-1" role="dialog" aria-labelledby="replyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("Reply", "Contact", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalContactId" name="id" value="" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="replyModalLabel">
                        <i class="fas fa-paper-plane mr-2"></i>Phản Hồi Yêu Cầu Hỗ Trợ Khách Hàng
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold">Email người nhận:</label>
                        <input type="text" id="modalCustomerEmail" class="form-control" readonly />
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Nội dung yêu cầu từ khách hàng:</label>
                        <textarea id="modalCustomerContent" class="form-control bg-light" rows="3" readonly></textarea>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-success">
                            <i class="fas fa-pencil-alt mr-1"></i>Nội dung hỗ trợ / phản hồi gửi qua email: <span class="text-danger">*</span>
                        </label>
                        <textarea name="replyContent" id="replyContent" class="form-control" rows="6" placeholder="Nhập câu trả lời, hướng dẫn hoặc giải pháp hỗ trợ cho khách hàng..." required></textarea>
                        <small class="form-text text-muted">
                            <i class="fas fa-info-circle mr-1"></i>Hệ thống sẽ gửi email này đến hòm thư của khách hàng và cập nhật trạng thái là <strong>Đã xử lý</strong>.
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i>Hủy
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-envelope mr-1"></i>Hoàn Thành & Gửi Mail
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('.btn-reply').click(function () {
                var contactId = $(this).data('id');
                var email = $(this).data('email');
                var content = $(this).data('content');

                $('#modalContactId').val(contactId);
                $('#modalCustomerEmail').val(email ? email : '(Chưa cung cấp email)');
                $('#modalCustomerContent').val(content);
                $('#replyContent').val('');

                $('#replyModal').modal('show');
            });
        });
    </script>
}
